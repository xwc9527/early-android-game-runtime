          "error_semantics": "kernel failure is a return in [-MAX_ERRNO, -1]; MAX_ERRNO is 4095",
          "lifecycle": "one int $0x80 on x86 or one swi #0 on ARM; the wrapper does not retry",
          "request_schema": "32-bit clock_gettime syscall number, the caller's clock id unchanged, and a pointer to a timespec of time_t tv_sec plus long tv_nsec",
