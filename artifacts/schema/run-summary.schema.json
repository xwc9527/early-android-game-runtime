{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agr.invalid/schema/run-summary.schema.json",
  "type": "object",
  "required": ["schema_version","run","changes","build","contracts","regressions","target","warnings","diagnostics","diagnosis","closure","artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "run": {"type":"object","required":["tested_commit","tested_tree","baseline_commit","branch","platform","valid_run","closure_attempt"],"properties":{"closure_attempt":{"type":"object","required":["classification","consumes_budget","automatic_rerun_permitted","required_stages","required_evidence","infrastructure_defects"],"properties":{"classification":{"enum":["NOT_APPLICABLE","VALID_PASS","VALID_FAIL","INVALID"]},"consumes_budget":{"type":"boolean"},"automatic_rerun_permitted":{"type":"boolean"}}}}},
    "changes": {"type":"object","required":["files","modules","stable_modules_touched"]},
    "build": {"type":"object","required":["status"]},
    "contracts": {"type":"object","required":["status","new_failures","resolved_failures"]},
    "regressions": {"type":"object","required":["status","new_failures","resolved_failures","unchanged_failures"]},
    "target": {"type":"object","required":["name","status","stage","normalized_signature","raw_fingerprint"]},
    "warnings": {"type":"object","required":["new","resolved"]},
    "diagnostics": {"type":"object","required":["passive","intrusive"]},
    "diagnosis": {
      "type":"object",
      "required":["observed_discontinuity","android_subsystem","upstream","agr_path","earliest_evidenced_divergence","classification","remaining_uncertainty","next_action","semantic_diff_artifact"],
      "properties": {
        "classification":{"enum":["ANDROID_SEMANTIC_BUG","HOST_ADAPTATION_BUG","AGR_INTERNAL_BUG","HARNESS_BUG","REFERENCE_MISMATCH","UNKNOWN"]},
        "upstream":{"type":"object","required":["map_entry","map_status","revision","path","source_verified"],"properties":{"map_status":{"enum":["VALID","STALE","UNVERIFIED","INVALID","NOT_APPLICABLE"]},"source_verified":{"type":"boolean"},"path":{"type":"array"}}},
        "agr_path":{"type":"array"},
        "earliest_evidenced_divergence":{"type":"object","required":["description","semantic_class","causal_status","evidence_level"],"properties":{"semantic_class":{"enum":["PUBLIC_OBSERVABLE","SEMANTIC_INVARIANT","ARCHITECTURE_INVARIANT","UPSTREAM_IMPLEMENTATION_DETAIL"]},"causal_status":{"enum":["OBSERVED","PLAUSIBLE","COUNTERFACTUAL_SUPPORTED","CONTRACT_CONFIRMED","REAL_GAME_CONFIRMED"]},"evidence_level":{"enum":["SOURCE_INFERRED","RUNTIME_OBSERVED","REFERENCE_CONFIRMED","COUNTERFACTUAL_SUPPORTED","CONTRACT_CONFIRMED","REAL_GAME_CONFIRMED"]}}},
        "remaining_uncertainty":{"type":"array"}
      }
    },
    "closure": {"type":"object","required":["target","tested_commit","tested_tree","state","eligible_for_merge"],"properties":{"state":{"enum":["IMPLEMENTED","CLOSED"]}}},
    "artifacts": {"type":"object"}
  }
}
