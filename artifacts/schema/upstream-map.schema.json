{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "android_baseline", "role", "entries"],
  "properties": {
    "schema_version": {"const": 2},
    "android_baseline": {"const": "Android 4.4.4_r2"},
    "role": {"const": "NAVIGATION_CACHE_NOT_ORACLE"},
    "legacy_navigation_policy": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "subsystem", "android_api", "upstream", "agr", "verified_at_commit", "status", "dependencies", "observable_semantics", "internal_invariants", "execution_placement", "host_substitutions", "known_deviations", "contracts", "legacy_navigation_only", "migration_authority"],
        "properties": {
          "status": {"enum": ["VALID", "STALE", "UNVERIFIED", "INVALID"]},
          "legacy_navigation_only": {"type": "boolean"},
          "migration_authority": {"const": false},
          "upstream": {"type": "object", "required": ["revision", "repository", "paths", "symbols", "source_hashes"]},
          "agr": {"type": "object", "required": ["paths", "symbols", "source_hashes"]}
        }
      }
    }
  }
}
