{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version","stage","module","normalized_signature","raw_fingerprint","evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"type":"string"},
    "module": {"type":"string"},
    "normalized_signature": {"type":"string"},
    "raw_fingerprint": {"type":"string"},
    "evidence": {"type":"object"},
    "passive": {"type":"boolean"},
    "intrusive": {"type":"boolean"}
    ,"classification":{"enum":["ANDROID_SEMANTIC_BUG","HOST_ADAPTATION_BUG","AGR_INTERNAL_BUG","HARNESS_BUG","REFERENCE_MISMATCH","UNKNOWN"]}
    ,"subsystem":{"type":"string"}
    ,"upstream_map_entry":{"type":"string"}
    ,"semantic_diff_artifact":{"type":"string"}
    ,"experimental":{"type":"boolean"}
    ,"timing_sensitive":{"type":"boolean"}
    ,"trace":{"type":"object","properties":{"bounded":{"type":"boolean"},"capacity":{"type":"integer","minimum":1},"record_size":{"type":"integer","minimum":1},"dropped":{"type":"integer","minimum":0}}}
  }
}
