{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agr.invalid/schema/semantic-diff.schema.json",
  "type": "object",
  "required": ["schema_version", "classification", "subsystem", "observed_discontinuity", "upstream", "required_semantics", "agr", "differences", "first_relevant_difference", "confidence", "needs_experiment", "validation"],
  "properties": {
    "schema_version": {"const": 1},
    "classification": {"enum": ["ANDROID_SEMANTIC_BUG", "HOST_ADAPTATION_BUG", "AGR_INTERNAL_BUG", "HARNESS_BUG", "REFERENCE_MISMATCH", "UNKNOWN"]},
    "subsystem": {"type": "string", "minLength": 1},
    "observed_discontinuity": {"type": "string", "minLength": 1},
    "upstream": {
      "type": "object",
      "required": ["version", "files", "call_path"],
      "properties": {
        "version": {"const": "Android 4.4.4_r2"},
        "files": {"type": "array", "items": {"type": "string"}},
        "call_path": {"type": "array", "items": {"type": "string"}}
      }
    },
    "required_semantics": {"type": "array", "items": {"type": "string"}},
    "agr": {
      "type": "object",
      "required": ["files", "call_path"],
      "properties": {
        "files": {"type": "array", "items": {"type": "string"}},
        "call_path": {"type": "array", "items": {"type": "string"}}
      }
    },
    "differences": {"type": "array", "items": {"type": "object", "required": ["id", "description", "relevance"]}},
    "first_relevant_difference": {"type": "string"},
    "confidence": {"enum": ["low", "medium", "high", "proven"]},
    "needs_experiment": {"type": "boolean"},
    "active_explanations": {"type": "array", "items": {"type": "string"}},
    "next_discriminating_action": {"type": "string"},
    "host_adaptation": {"type": "string"},
    "validation": {"type": "array", "items": {"type": "string"}},
    "experimental": {"type": "boolean"}
  }
}
