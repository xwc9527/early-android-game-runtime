{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "decision", "bindings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "decision": {"type": "object"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"type": "object"}
    }
  }
}
