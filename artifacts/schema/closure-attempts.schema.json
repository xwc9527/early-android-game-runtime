{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "policy", "budget", "attempts"],
  "properties": {
    "schema_version": {"const": 1},
    "policy": {
      "type": "object",
      "required": ["valid_attempt_budget", "invalid_attempts_consume_budget", "automatic_reruns_after_invalid", "second_run_after_valid_fail_requires_approval"]
    },
    "budget": {
      "type": "object",
      "required": ["valid_attempts_used", "valid_attempts_remaining"]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "target", "tested_commit", "tested_tree", "classification", "consumes_budget"],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "classification": {"enum": ["VALID_PASS", "VALID_FAIL", "INVALID"]},
          "consumes_budget": {"type": "boolean"},
          "approval_reference": {"type": "object", "required": ["target", "commit", "tree", "reference"]},
          "failure_classification": {"enum": ["ANDROID_SEMANTIC_BUG", "HOST_ADAPTATION_BUG", "AGR_INTERNAL_BUG", "HARNESS_BUG", "WORKFLOW_DEFECT", "REFERENCE_MISMATCH", "UNKNOWN", "EXTERNAL_SERVICE_FAILURE"]},
          "defect_class": {"enum": ["HARNESS_DEFECT", "RUNNER_DEFECT", "COLLECTOR_DEFECT", "ARTIFACT_DEFECT", "TIMEOUT_HIERARCHY_DEFECT", "WORKFLOW_DEFECT"]}
        }
      }
    }
  }
}
