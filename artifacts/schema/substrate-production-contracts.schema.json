{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "contracts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "semantic_cluster", "status", "source_revision", "source_owner_digest",
          "production_module", "tested_commit", "tested_tree", "closure_run"
        ],
        "additionalProperties": false,
        "properties": {
          "semantic_cluster": {"type": "string", "minLength": 1},
          "status": {"const": "PRODUCTION_CLOSED"},
          "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "source_owner_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "production_module": {"type": "string", "minLength": 1},
          "tested_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "tested_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "closure_run": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
